class main() {
    var bob: int = 10;
    print(bob);
    bob += 3;
    print(bob);
    bob -= 3;
    print(bob);
    bob *= 3;
    print(bob);
    bob /= 29;
    print(bob);

    var order_of_operations: int = 2 + 3 * 4;
    print(order_of_operations);

    var grouped: int = (2 + 3) * 4;
    print(grouped);

    var negative: int = -5 + 10;
    print(negative);

    var is_big: bool = (order_of_operations * 2) > 20;
    print(is_big);
}
