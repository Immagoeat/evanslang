{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "evanslang",
  "scopeName": "source.evanslang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#mentions" },
    { "include": "#class-decl" },
    { "include": "#keywords" },
    { "include": "#booleans" },
    { "include": "#types" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#dotted-call" },
    { "include": "#function-call" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.evanslang",
          "match": "#.*$"
        }
      ]
    },
    "mentions": {
      "patterns": [
        {
          "match": "(@)\\s*(mentions)\\b",
          "captures": {
            "1": { "name": "keyword.other.at.evanslang" },
            "2": { "name": "keyword.control.import.evanslang" }
          }
        },
        {
          "name": "keyword.operator.arrow.evanslang",
          "match": "->"
        }
      ]
    },
    "class-decl": {
      "patterns": [
        {
          "match": "\\b(class)\\s+(main|init)\\b",
          "captures": {
            "1": { "name": "keyword.control.class.evanslang" },
            "2": { "name": "entity.name.function.entrypoint.evanslang" }
          }
        },
        {
          "match": "\\b(class)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.control.class.evanslang" },
            "2": { "name": "entity.name.function.evanslang" }
          }
        },
        {
          "name": "storage.modifier.ment.evanslang",
          "match": "\\bment\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.evanslang",
          "match": "\\b(if|elseif|else)\\b"
        },
        {
          "name": "keyword.control.loop.evanslang",
          "match": "\\b(while|for)\\b"
        },
        {
          "name": "keyword.control.exception.evanslang",
          "match": "\\b(try|catch|throw)\\b"
        },
        {
          "name": "storage.type.var.evanslang",
          "match": "\\bvar\\b"
        },
        {
          "name": "support.function.builtin.evanslang",
          "match": "\\b(print|input)\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.evanslang",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.evanslang",
          "match": "\\b(ptr|int|float|str|bool)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.evanslang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.evanslang",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.evanslang",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.evanslang",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.compound-assignment.evanslang",
          "match": "(\\+=|-=|\\*=|/=)"
        },
        {
          "name": "keyword.operator.comparison.evanslang",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.evanslang",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.assignment.evanslang",
          "match": "="
        },
        {
          "name": "keyword.operator.pointer.evanslang",
          "match": "(&|\\*)(?=\\s*[A-Za-z_])"
        },
        {
          "name": "keyword.operator.arithmetic.evanslang",
          "match": "(\\+|-|\\*|/)"
        }
      ]
    },
    "dotted-call": {
      "patterns": [
        {
          "comment": "bob.parse(int) - the .parse(...) method-style call",
          "match": "\\.(parse)\\s*(?=\\()",
          "captures": {
            "1": { "name": "support.function.parse.evanslang" }
          }
        },
        {
          "comment": "alias.ClassName; - a cross-file class call",
          "match": "\\.([A-Za-z_][A-Za-z0-9_]*)\\s*(?=;)",
          "captures": {
            "1": { "name": "entity.name.function.call.evanslang" }
          }
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "comment": "NAME; - a local class call (not print/input, those are builtins above)",
          "match": "\\b(?!print\\b|input\\b|var\\b|if\\b|elseif\\b|else\\b|while\\b|for\\b|try\\b|catch\\b|throw\\b|true\\b|false\\b|class\\b)([A-Za-z_][A-Za-z0-9_]*)\\s*(?=;)",
          "captures": {
            "1": { "name": "entity.name.function.call.evanslang" }
          }
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.evanslang",
          "match": ";"
        },
        {
          "name": "punctuation.separator.colon.evanslang",
          "match": ":"
        },
        {
          "name": "punctuation.separator.dot.evanslang",
          "match": "\\."
        },
        {
          "name": "punctuation.section.braces.evanslang",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.parens.evanslang",
          "match": "[()]"
        }
      ]
    }
  }
}
